{
  "name": "@openclaw/ndr",
  "version": "0.0.1",
  "type": "module",
  "description": "OpenClaw channel plugin for nostr-double-ratchet (forward-secure E2E encryption)",
  "keywords": ["openclaw", "nostr", "double-ratchet", "ndr", "e2e", "encryption", "chat"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mmalmi/openclaw-ndr"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "files": ["dist/", "src/", "index.ts", "openclaw.plugin.json", "README.md"],
  "openclaw": {
    "id": "ndr",
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  }
}
